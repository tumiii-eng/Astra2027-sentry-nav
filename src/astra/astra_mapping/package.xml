<?xml version="1.0"?>
<package format="3">
  <name>astra_mapping</name>
  <version>0.1.0</version>
  <description>建图功能包（对应报告 5.4 与 5.5.2）：障碍物识别二维栅格、二维有符号距离场 ESDF，以及发布二维障碍图的占据节点。</description>
  <maintainer email="tumi@example.com">tumi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>astra_common</depend>
  <depend>astra_perception</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <build_depend>eigen</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
